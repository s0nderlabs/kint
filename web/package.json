{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "sync-core": "rm -rf lib/core && cp -R ../js/src lib/core && cp ../js/README.md lib/core/README.md && sed -i '' -E \"s#from '(\\./[A-Za-z0-9_]+)\\.js'#from '\\1'#g\" lib/core/*.ts"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "lenis": "1.3.26",
    "gsap": "3.15.0",
    "viem": "2.56.3",
    "@noble/hashes": "2.4.0",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
